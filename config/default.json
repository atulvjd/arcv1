{
  "kernel": {
    "name": "ArcV1",
    "version": "1.0.0",
    "debug": false
  },
  "models": {
    "default": {
      "provider": "mock",
      "model_id": "mock-default",
      "parameters": {
        "temperature": 0.7,
        "max_tokens": 1024
      }
    }
  },
  "tools": {
    "filesystem": {
      "enabled": true,
      "allowed_paths": [
        "."
      ]
    },
    "terminal": {
      "enabled": true,
      "allowed_commands": null
    }
  },
  "scheduler": {
    "poll_interval": 0.1,
    "max_concurrent": 4
  },
  "services": {
    "llm": {
      "default_params": {
        "temperature": 0.7,
        "max_tokens": 1024
      }
    },
    "memory": {
      "backend": "in_memory"
    }
  }
}